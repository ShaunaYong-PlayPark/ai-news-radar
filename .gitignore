# Local environment and secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
*token*
*cookie*
cookies.json

# Python / tooling
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Private source inputs
feeds/follow.opml
feeds/*.private.opml
feeds/private*.opml

# Optional private/generated digests
data/email-digest.json

# Sensor Tower CSV exports - proprietary paid data, never committed.
# Only the derived JSON index (data/game-rank-index.json) is committed.
data/*.csv
data/*.xlsx

# Live Game News pipeline internal state - lives on the orphan `game-data`
# branch (see .github/workflows/update-game-news.yml), never accumulated
# into master's history. data/game-news.json is intentionally NOT listed
# here - a single static copy stays committed as a fallback baseline for
# game.html if the live branch is ever unreachable, but master's copy is
# never recommitted on a recurring cadence, so it can't cause the same
# growth problem as AI News's archive.json.
data/game-news-state.json

# Local OS/editor noise
.DS_Store
.idea/
.vscode/

# Local coding-agent settings (Claude Code, Codex, etc.)
.claude/settings.local.json
.codex/
work/
